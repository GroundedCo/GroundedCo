# ============================================================
# Supabase — self-hosted instance
# ============================================================
# URL of your Supabase instance (cloud or self-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/Public key — safe to expose to the browser (respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Service Role key — NEVER expose to the browser (bypasses RLS, admin only)
# Only used in API routes and server components
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ============================================================
# Razorpay — get your test keys from https://dashboard.razorpay.com/app/keys
# Use TEST mode keys during development (prefix rzp_test_)
# ============================================================
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_SECRET

# Public key exposed to browser (must match RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# ============================================================
# Cloudinary — cloud name for image CDN (fetch/proxy mode, no API key needed)
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
