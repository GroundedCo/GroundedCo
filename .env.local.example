# ============================================================
# Supabase — self-hosted instance
# ============================================================
# URL of your Supabase instance (cloud or self-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/Public key — safe to expose to the browser (respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Service Role key — NEVER expose to the browser (bypasses RLS, admin only)
# Only used in API routes and server components
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ============================================================
# Razorpay — get your test keys from https://dashboard.razorpay.com/app/keys
# Use TEST mode keys during development (prefix rzp_test_)
# ============================================================
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_SECRET

# Public key exposed to browser (must match RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# ============================================================
# "One of 1" bid alert emails — via Resend (https://resend.com)
# ============================================================
RESEND_API_KEY=re_REPLACE_ME
# Who gets the alert (comma-separate for several people)
BID_ALERT_EMAIL_TO=studio@yourdomain.com
# Sender — must be on a domain verified in Resend.
# Leave unset to use Resend's test sender (only delivers to the Resend account owner's email).
BID_ALERT_EMAIL_FROM=Grounded Studio <bids@yourdomain.com>

# ============================================================
# Spatial Partner Registry emails (/spatial-partners) — via Resend
# ============================================================
# Both optional — by default these reuse the bid-alert setup above
# (same RESEND_API_KEY, alerts go to BID_ALERT_EMAIL_TO).
#
# Team alert recipient(s), comma-separated. Falls back to BID_ALERT_EMAIL_TO.
# PARTNER_ALERT_EMAIL_TO=hello@thegrounded.co.in
#
# Sender on a Resend-verified domain. Falls back to BID_ALERT_EMAIL_FROM.
# Until one of the two is set, the confirmation email to studios is skipped
# (Resend's test sender can only deliver to the account owner).
# PARTNER_EMAIL_FROM=The Grounded Company <hello@thegrounded.co.in>
